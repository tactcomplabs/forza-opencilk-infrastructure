#!/bin/sh

case "$1" in
/*) OPENCILK_SOURCE="$1" ;;
-h | -help | --help)
  echo "USAGE: build-pt2 source-dir build-dir [core-count]"
  echo "  source-dir: Absolute path to OpenCilk source (opencilk-project repository root)"
  echo "  build-dir:  Absolute path for build output"
  echo "  core-count: Optional number of cores to use for parallel build"
  exit 1
  ;;
-*)
  echo "Error: Invalid option '$1'"
  echo "Run with --help for usage information"
  exit 1
  ;;
*)
  echo "Error: Source directory must be an absolute path (starting with /)"
  echo "Provided: $1"
  echo "Run with --help for usage information"
  exit 1
  ;;
esac

case "$2" in
/*) BUILD_DIR="$2" ;;
*)
  echo "Error: Build directory must be an absolute path (starting with /)"
  echo "Provided: $2"
  echo "Run with --help for usage information"
  exit 1
  ;;
esac

DEFAULT_NCPU=1
NCPU="${3}"
if test -z "${NCPU}" -a -r /proc/cpuinfo; then
  NCPU=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
fi
if test -z "${NCPU}"; then
  if test -x /sbin/sysctl -o -x /usr/sbin/sysctl; then
    NCPU=$(PATH=${PATH}:/sbin:/usr/sbin sysctl -n hw.ncpu)
  fi
fi
if test -z "${NCPU}" -o 0 -eq "${NCPU}"; then
  echo "Warning: Could not detect CPU count, defaulting to ${DEFAULT_NCPU} core"
  NCPU=${DEFAULT_NCPU}
fi

set -euo pipefail

# RISC-V toolchain configuration
TOOLCHAIN_PREFIX="riscv64-unknown-elf"
SYSROOT="$(${TOOLCHAIN_PREFIX}-gcc --print-sysroot)"
GCC_BIN="$(which ${TOOLCHAIN_PREFIX}-gcc)"
GCC_TOOLCHAIN="$(dirname $(dirname "${GCC_BIN}"))"
echo "GCC Toolchain: ${GCC_TOOLCHAIN}"

# Derived paths
CLANG_BIN_DIR="${BUILD_DIR}/bin" # from the first stage (native)
OPENCILK_BUILD="${BUILD_DIR}/runtimes-riscv64"
INSTALL_PREFIX="${HOME}/.local/opt/opencilk-riscv"

# Target configuration
TARGET="--target=${TOOLCHAIN_PREFIX}"
# TODO: These may need to change to the forza options
MARCH="-march=rv64gc"
MABI="-mabi=lp64d"

# Make the directory and go there
mkdir -p "${OPENCILK_BUILD}"
cd "${OPENCILK_BUILD}"

# Configure build
cmake \
  -DLLVM_ENABLE_RUNTIMES="cheetah;cilktools" \
  -DLLVM_TARGETS_TO_BUILD="RISCV" \
  -DLLVM_TABLEGEN="${CLANG_BIN_DIR}/llvm-tblgen" \
  -DCLANG_TABLEGEN="${CLANG_BIN_DIR}/clang-tblgen" \
  -DLLVM_MIN_TBLGEN="${CLANG_BIN_DIR}/llvm-min-tblgen" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="${INSTALL_PREFIX}" \
  -DCMAKE_C_COMPILER="${CLANG_BIN_DIR}/clang" \
  -DCMAKE_CXX_COMPILER="${CLANG_BIN_DIR}/clang++" \
  -DCMAKE_C_FLAGS="${TARGET} ${MARCH} ${MABI} --sysroot=${SYSROOT} --gcc-toolchain=${GCC_TOOLCHAIN}" \
  -DCMAKE_CXX_FLAGS="${TARGET} ${MARCH} ${MABI} --sysroot=${SYSROOT} --gcc-toolchain=${GCC_TOOLCHAIN}" \
  -DCMAKE_ASM_COMPILER="${CLANG_BIN_DIR}/clang" \
  "${OPENCILK_SOURCE}/llvm"

# Build
cmake --build . -- -j"${NCPU}"
